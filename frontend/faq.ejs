        body {
            font-family: 'Poppins', sans-serif;
            scroll-behavior: smooth;
            background-image: linear-gradient(rgba(248, 250, 252, 0.75), rgba(248, 250, 252, 0.75)), url('/frontend/assets/images/faq_bg.png');
